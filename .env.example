# --------------------------------------------------
# QuantPilot AI Configuration
# --------------------------------------------------

# Application
APP_NAME=QuantPilot AI
DEBUG=false
JSON_LOGS=false
AI_DECISION_LOG_RETENTION_DAYS=90
# Persistent runtime root. Use a different absolute directory for every
# live, paper, staging, and test environment to prevent state crossover.
DATA_DIR=./data

# --------------------------------------------------
# Security (REQUIRED for production)
# --------------------------------------------------
# SECURITY WARNING: Generate strong unique secrets for production!
# Run: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
WEBHOOK_SECRET=
COOKIE_SECURE=auto

# Webhook HMAC signature verification (optional, for custom integrations)
# TradingView does NOT support HMAC headers - only enable for custom senders
WEBHOOK_HMAC_HEADER_ENABLED=false
WEBHOOK_HMAC_SECRET=
WEBHOOK_HMAC_HEADER_NAME=X-Webhook-Signature

# Encryption key for sensitive data at rest
# SECURITY WARNING: Must be set in production for user settings encryption!
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=

# --------------------------------------------------
# Default Admin Account
# --------------------------------------------------
# SECURITY: Change these before production deployment!
DEFAULT_ADMIN_USERNAME=your_admin_username_here
DEFAULT_ADMIN_EMAIL=your_admin_email@example.com
# Optional. Leave blank to generate a one-time random bootstrap password at:
#   ${DATA_DIR}/bootstrap_admin_password.txt
# Set a strong value here only if you want to supply the first admin password yourself.
DEFAULT_ADMIN_PASSWORD=

# --------------------------------------------------
# AI Provider Configuration
# --------------------------------------------------
AI_PROVIDER=deepseek
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1000
AI_CUSTOM_PROMPT=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# OpenRouter
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=QuantPilot AI

# Custom AI Provider
CUSTOM_AI_PROVIDER_ENABLED=false
CUSTOM_AI_PROVIDER_NAME=custom
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=
CUSTOM_AI_API_URL=

# AI Timeouts
AI_CONNECT_TIMEOUT_SECS=10
AI_READ_TIMEOUT_SECS=90
AI_WRITE_TIMEOUT_SECS=30
AI_POOL_TIMEOUT_SECS=10
AI_MAX_RETRIES=3
AI_MAX_CONCURRENT_CALLS=5
AI_MAX_PROVIDER_REQUESTS_PER_DAY=500
AI_WEBHOOK_MAX_PROVIDER_REQUESTS_PER_DAY=200
AI_SIGNAL_QUEUE_LIMIT=50
AI_GLOBAL_PROCESSING_SEMAPHORE=5
AI_SIGNAL_PROCESSING_INTERVAL_SECS=1
AI_DYNAMIC_INTERVAL_ENABLED=true
AI_DYNAMIC_INTERVAL_HIGH_LOAD_THRESHOLD=30
AI_DYNAMIC_INTERVAL_HIGH_LOAD_MULTIPLIER=2
AI_DYNAMIC_CACHE_TTL_ENABLED=true
AI_DYNAMIC_CACHE_TTL_BASE=60
AI_DYNAMIC_CACHE_TTL_HIGH_VOLATILITY_MULTIPLIER=0.5
AI_DYNAMIC_CACHE_TTL_LOW_VOLATILITY_MULTIPLIER=2
AI_SMC_CACHE_TTL_ENABLED=true
AI_SMC_CACHE_TTL_BASE=120
AI_SMC_CACHE_TTL_HIGH_VOL=60
AI_SMC_CACHE_TTL_LOW_VOL=180
AI_PREFILTER_ENHANCED_TIMEOUT_SECS=30
AI_BATCH_SIGNALS_ENABLED=false
AI_BATCH_SIGNALS_WINDOW_SECS=5
AI_BATCH_SIGNALS_MAX_COUNT=3
AI_PREFETCH_MARKET_DATA=true
AI_WEBSOCKET_MARKET_DATA_ENABLED=false

# AI Voting (multi-model consensus)
AI_VOTING_ENABLED=false
AI_VOTING_MODELS=[]
AI_VOTING_WEIGHTS={}
AI_VOTING_STRATEGY=weighted

# --------------------------------------------------
# Exchange Configuration
# --------------------------------------------------
EXCHANGE=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_PASSWORD=
LIVE_TRADING=false
# Enables exchange testnet/sandbox endpoints when LIVE_TRADING=true.
# Keep LIVE_TRADING=false for local paper trading with no exchange order.
EXCHANGE_SANDBOX_MODE=false
EXCHANGE_MARKET_TYPE=contract
EXCHANGE_DEFAULT_ORDER_TYPE=market
EXCHANGE_STOP_LOSS_ORDER_TYPE=market
EXCHANGE_POOL_MAX_SIZE=50
# JSON object for per-timeframe limit order timeouts, e.g. {"1m":60,"5m":300}
EXCHANGE_LIMIT_TIMEOUT_OVERRIDES={}

# Confirmed pre-execution failure handling and leverage setup retries.
AUTO_APPROVE_FAILED_ORDERS=false
AUTO_REJECT_FAILED_ORDERS=false
AUTO_RETRY_LEVERAGE_ERRORS=true
MAX_LEVERAGE_RETRY_ATTEMPTS=3
LEVERAGE_RETRY_DELAY_SECS=1

# --------------------------------------------------
# Telegram Notifications
# --------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Notification language: en or zh
NOTIFICATION_LANGUAGE=en

# --------------------------------------------------
# Risk Management
# --------------------------------------------------
ACCOUNT_EQUITY_USDT=10000
MAX_POSITION_PCT=10.0
MAX_DAILY_TRADES=10
MAX_DAILY_LOSS_PCT=5.0
MAX_TOTAL_LOSS_PCT=20.0
EXIT_MANAGEMENT_MODE=ai
AI_RISK_PROFILE=balanced
CUSTOM_STOP_LOSS_PCT=1.5
AI_EXIT_SYSTEM_PROMPT=

# Position Sizing Mode
# percentage: AI suggests fraction of max_position_pct
# fixed: Fixed USDT amount per trade (FIXED_POSITION_SIZE_USDT)
# risk_ratio: Risk X% of account per trade (RISK_PER_TRADE_PCT, requires valid SL)
POSITION_SIZING_MODE=percentage
FIXED_POSITION_SIZE_USDT=100
RISK_PER_TRADE_PCT=1.0
MAX_SLIPPAGE_PCT=1.0
MAX_POSITION_NOTIONAL_USDT=10000
ROLLING_1H_MAX_DRAWDOWN_PCT=5.0
ROLLING_4H_MAX_DRAWDOWN_PCT=10.0

# --------------------------------------------------
# Take Profit Configuration
# --------------------------------------------------
TP_LEVELS=1
TP1_PCT=2.0
TP2_PCT=4.0
TP3_PCT=6.0
TP4_PCT=10.0
TP1_QTY=25.0
TP2_QTY=25.0
TP3_QTY=25.0
TP4_QTY=25.0

# --------------------------------------------------
# Trailing Stop Configuration
# --------------------------------------------------
TRAILING_STOP_MODE=none
TRAILING_STOP_PCT=1.0
TRAILING_ACTIVATION_PCT=1.0
TRAILING_STEP_PCT=0.5

# --------------------------------------------------
# Server Configuration
# --------------------------------------------------
PUBLIC_BASE_URL=
HOST=0.0.0.0
PORT=8000
# Reject delayed entry webhooks after this many seconds. Close signals are exempt.
WEBHOOK_ENTRY_MAX_AGE_SECS=300
# Set true only when the app is behind a trusted reverse proxy/CDN.
TRUST_PROXY_HEADERS=false

# CORS Origins (comma-separated)
# IMPORTANT: In production (LIVE_TRADING=true), CORS cannot be '*'.
# Set explicit origins, e.g.: CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ORIGINS=http://localhost:8000

# Trusted Hosts (comma-separated)
# IMPORTANT: In production (LIVE_TRADING=true), TRUSTED_HOSTS cannot be '*'.
# Set explicit hosts, e.g.: TRUSTED_HOSTS=yourdomain.com,app.yourdomain.com
TRUSTED_HOSTS=localhost,127.0.0.1

# --------------------------------------------------
# Database Configuration
# --------------------------------------------------
# SQLite (default)
DATABASE_URL=sqlite+aiosqlite:///./data/server.db

# PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/quantpilot_ai

# Database Pool Settings (PostgreSQL only)
# Recommended for high-traffic deployments: pool_size=15, max_overflow=20
# This allows up to 35 concurrent connections (webhook + position monitor + scheduler + WebSocket)
DATABASE_POOL_SIZE=15
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --------------------------------------------------
# Redis Cache (optional)
# --------------------------------------------------
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/0
REDIS_ENABLED=false
REDIS_TTL=300
REDIS_PASSWORD=

# --------------------------------------------------
# Auto Market Scanner
# --------------------------------------------------
# Default is disabled and observe-only. Observe mode scans, analyzes, notifies,
# and audits, but never creates paper orders, positions, or live orders.
SCANNER_ENABLED=false
SCANNER_MODE=observe
SCANNER_OBSERVE_AI_ENABLED=false
SCANNER_INTERVAL_SECS=600
SCANNER_WATCHLIST=["BTCUSDT","ETHUSDT","XAUUSD","XAGUSD","XTIUSD"]
SCANNER_SOURCE_MODE=manual
SCANNER_SOURCE_EXCHANGE=
SCANNER_SOURCE_MARKET_TYPE=
SCANNER_DATA_SOURCE_POLICY=fallback
SCANNER_UNIVERSE_TOP_N=50
SCANNER_UNIVERSE_MIN_QUOTE_VOLUME=5000000
SCANNER_UNIVERSE_CACHE_TTL_SECS=300
SCANNER_CONFIRM_MAX_VOLUME_DEVIATION_PCT=80
SCANNER_INCLUDE_SYMBOLS=[]
SCANNER_EXCLUDE_SYMBOLS=[]
SCANNER_TIMEFRAMES=["15m","1h","4h"]
SCANNER_MIN_SCORE=65
SCANNER_MAX_CANDIDATES_PER_RUN=3
SCANNER_SYMBOL_COOLDOWN_SECS=1800
SCANNER_SETUP_COOLDOWN_SECS=14400
SCANNER_MAX_SIGNALS_PER_DAY=15
SCANNER_MAX_AI_CALLS_PER_DAY=30
SCANNER_RSI_LOWER=35
SCANNER_RSI_UPPER=65
SCANNER_MIN_ATR_PCT=0.10
SCANNER_MAX_SPREAD_PCT=0.35
SCANNER_SHUTDOWN_TIMEOUT_SECS=30
# Live whitelist uses the exchange execution symbol, not the watchlist symbol.
# Commodity/mapped assets should stay out of this list until manually validated.
SCANNER_LIVE_SYMBOL_WHITELIST=["BTCUSDT","ETHUSDT"]
SCANNER_LIVE_MIN_OUTCOME_SAMPLES=30
SCANNER_LIVE_MIN_EXPECTANCY_PCT=0
# Watchlist Symbol -> Exchange Execution Symbol.
# Example: XAUUSD uses Yahoo Finance data internally, while PAXGUSDT is the
# exchange execution symbol. commodity_data.py also maps XAU -> GCUSD for Yahoo.
# Mapped assets are observe/paper-only unless their exchange_symbol is in the
# live whitelist and exchange market validation passes.
SCANNER_SYMBOL_MAP={"XAUUSD":{"exchange_symbol":"PAXGUSDT","exchange_name":"binance","type":"spot"}}
SCANNER_MAX_CONCURRENT_FETCHES=4
SCANNER_BUNDLE_CACHE_TTL_SECS=45
SCANNER_AI_MIN_CONFIDENCE=0.70
SCANNER_REJECTED_SYMBOL_COOLDOWN_SECS=300
SCANNER_BLOCKED_SYMBOL_COOLDOWN_SECS=0
SCANNER_MTF_CONFIRMATION_BONUS=6
SCANNER_MTF_CONFLICT_PENALTY=10
SCANNER_MIN_VOLUME_RATIO=0.15
SCANNER_MAX_CANDLE_GAP_RATIO=0.15
SCANNER_MAX_PRICE_DEVIATION_PCT=2
SCANNER_SCORE_WEIGHTS={}
SCANNER_EMA200_ENABLED=true
SCANNER_HTF_CONFLICT_ENABLED=true
SCANNER_REGIME_FILTER_ENABLED=true
SCANNER_ADAPTIVE_THRESHOLD_ENABLED=false
SCANNER_ADAPTIVE_MIN_SCORE_FLOOR=50
SCANNER_ADAPTIVE_MIN_SCORE_CEILING=85
SCANNER_ADAPTIVE_WIN_RATE_TARGET=55
SCANNER_ADAPTIVE_LOOKBACK_DAYS=7
SCANNER_ADAPTIVE_ADJUSTMENT_STEP=2.5
SCANNER_ADAPTIVE_COOLDOWN_LEVELS=5
SCANNER_ADAPTIVE_COOLDOWN_BASE_SECS=300
SCANNER_ADAPTIVE_COOLDOWN_MULTIPLIER=2
SCANNER_LEARNING_ENABLED=true
SCANNER_OUTCOME_LOOKBACK_DAYS=30
SCANNER_OUTCOME_MAX_SYNC_POSITIONS=50
SCANNER_OUTCOME_PATH_METRICS_ENABLED=true
SCANNER_WALK_FORWARD_ENABLED=true
SCANNER_WALK_FORWARD_MIN_SAMPLES=30
SCANNER_WALK_FORWARD_VALIDATION_RATIO=0.30
SCANNER_WALK_FORWARD_THRESHOLD_STEP=2.5
SCANNER_HARD_FILTERS_ENABLED=true
SCANNER_REQUIRE_SUPPORT_ZONE=true
SCANNER_REQUIRE_STRUCTURE_ALIGNMENT=true
SCANNER_MIN_MTF_CONFIRMATIONS=2
SCANNER_MIN_RR_RATIO=1.40
SCANNER_MTF_CONSENSUS_ENABLED=true
SCANNER_MTF_CONSENSUS_MIN_MARGIN=8
SCANNER_MTF_CONSENSUS_HTF_WEIGHT=1.40
SCANNER_MTF_CONSENSUS_LTF_WEIGHT=0.80
SCANNER_LIQUIDITY_FILTER_ENABLED=true
SCANNER_LIQUIDITY_ORDER_SIZE_USDT=1000
SCANNER_MIN_QUOTE_VOLUME_24H=5000000
SCANNER_MIN_ORDERBOOK_DEPTH_USDT=50000
SCANNER_MAX_ESTIMATED_SLIPPAGE_PCT=0.25
SCANNER_MIN_ORDERBOOK_IMBALANCE_LONG=0.60
SCANNER_MAX_ORDERBOOK_IMBALANCE_SHORT=1.80
SCANNER_EVENT_FILTER_ENABLED=true
SCANNER_FUNDING_BLACKOUT_MINUTES=10
SCANNER_MAX_ABS_FUNDING_RATE=0.0015
SCANNER_LOW_LIQUIDITY_UTC_HOURS=[]
SCANNER_EVENT_BLACKOUT_UTC_WINDOWS=[]
SCANNER_PORTFOLIO_RISK_ENABLED=true
SCANNER_MAX_SAME_DIRECTION_EXPOSURE=3
SCANNER_MAX_CORRELATED_SIGNALS_PER_RUN=2
SCANNER_CORRELATION_BUCKETS={"crypto_majors":["BTC","ETH","SOL","BNB","XRP","ADA","DOGE","AVAX","LINK","DOT","LTC"],"metals":["XAU","XAG","PAXG"],"oil":["WTI","BRENT","USOIL","UKOIL"]}
SCANNER_SCAN_TIMEOUT_SECS=300

# Database (PostgreSQL when using Docker)
POSTGRES_PASSWORD=
SIGNAL_SERVER_IMAGE=ghcr.io/ikun52012/quantpilot-ai:v5.5.1
SIGNAL_UPDATER_IMAGE=ghcr.io/ikun52012/quantpilot-ai-updater:v5.5.1
# One-click Docker updates require starting the compose `updates` profile and mounting the Docker socket.
AUTO_UPDATE_ENABLED=false

# --------------------------------------------------
# Rate Limiting
# --------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECS=300
REGISTER_MAX_ATTEMPTS=5
REGISTER_WINDOW_SECS=600
WEBHOOK_MAX_ATTEMPTS=30
WEBHOOK_WINDOW_SECS=60
API_DEFAULT_LIMIT=60/minute

# --------------------------------------------------
# Position Monitor
# --------------------------------------------------
POSITION_MONITOR_INTERVAL_SECS=5

# --------------------------------------------------
# Pre-Filter
# --------------------------------------------------
PREFILTER_DISABLED_CHECKS=

# --------------------------------------------------
# Enhanced Filters (v3)
# --------------------------------------------------
ENHANCED_FILTERS_ENABLED=true

# Open Interest Change
OI_CHANGE_THRESHOLD_PCT=5.0
OI_CHANGE_LOOKBACK_HOURS=4

# Whale Activity
WHALE_THRESHOLD_USD=1000000
WHALE_ALERT_API_KEY=

# Correlated Assets
CORRELATED_ASSETS_ENABLED=true
CORRELATED_ASSETS_LOOKBACK_BARS=24

# Etherscan API (for whale blockchain data)
ETHERSCAN_API_KEY=

# Glassnode API (optional)
GLASSNODE_API_KEY=

# CryptoQuant API (optional)
CRYPTOQUANT_API_KEY=

# --------------------------------------------------
# SMC Analyzer (Smart Money Concepts)
# --------------------------------------------------
SMC_FVG_LOOKBACK=5
SMC_FVG_MIN_GAP_PCT=0.5
SMC_OB_THRESHOLD=0.5
SMC_SWING_LOOKBACK=3
SMC_MIN_IMPULSE_PCT=0.5

# --------------------------------------------------
# Voting Configuration
# --------------------------------------------------
VOTING_ENABLED=false
VOTING_STRATEGY=weighted
VOTING_MIN_CONFIDENCE=0.6
VOTING_TIMEOUT_SECS=120

# --------------------------------------------------
# Strategy Monitor
# --------------------------------------------------
STRATEGY_MONITOR_ENABLED=false
STRATEGY_MONITOR_INTERVAL_SECS=60
STRATEGY_MONITOR_MAX_POSITIONS=10

# --------------------------------------------------
# Backtest Defaults
# --------------------------------------------------
BACKTEST_DEFAULT_CAPITAL=10000
BACKTEST_DEFAULT_LEVERAGE=1.0
BACKTEST_DEFAULT_FEE_PCT=0.04
BACKTEST_DEFAULT_SLIPPAGE_PCT=0.01

# --------------------------------------------------
# WebSocket Configuration
# --------------------------------------------------
WS_POSITION_UPDATE_INTERVAL_SECS=5
WS_PRICE_UPDATE_INTERVAL_SECS=3
WS_HEARTBEAT_INTERVAL_SECS=30

# --------------------------------------------------
# PWA / Mobile
# --------------------------------------------------
# PWA/i18n are served by static assets and API endpoints.
# There is currently no environment toggle for default UI language or push delivery.

# --------------------------------------------------
# Two-Factor Authentication (2FA / TOTP)
# --------------------------------------------------
# 2FA is optional and can be enabled per-user from the dashboard.
# No global toggle needed 鈥?each user controls their own 2FA.

# --------------------------------------------------
# Security Warning
# --------------------------------------------------
# 鈿狅笍 PRODUCTION WARNING: Set JWT_SECRET to a strong, unique value before
# exposing to the internet. If DEFAULT_ADMIN_PASSWORD is left blank, read the
# generated bootstrap password from data/bootstrap_admin_password.txt and
# change it immediately after first login.
# Failure to do so puts your trading accounts at extreme risk.
